# Copy this file to `.env` and fill in your own values.
# `.env` is ignored by git — never commit real secrets.

# Port the API listens on
PORT=5000

# MongoDB connection string.
# Local MongoDB:      mongodb://127.0.0.1:27017/edustream
# MongoDB Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net/edustream
MONGO_URI=mongodb://127.0.0.1:27017/edustream

# Origin allowed to call the API (the frontend). Use * during development.
CLIENT_ORIGIN=*
